APP_NAME="ApexCare Enterprise HMS"
APP_ENV=production
APP_KEY=base64:GENERATE_PRODUCTION_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://hms.yourhealthnetwork.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (PostgreSQL 18)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hospital_prod_db
DB_USERNAME=hospital_prod_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Session & Cache (Redis 7)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=apexcare_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue Worker (Redis)
QUEUE_CONNECTION=redis

# Multi-Channel Clinical Alerts (AWS SNS / Twilio / WhatsApp)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_PROVIDER=simulated
WHATSAPP_PROVIDER=simulated

# HIPAA S3 / Object Storage Document Vault
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=apexcare-clinical-docs-vault
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail / SMTP Server
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notifications@yourhealthnetwork.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite / Frontend Build
VITE_APP_NAME="${APP_NAME}"
